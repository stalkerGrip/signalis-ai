{
  "schema": "stage_rule_set.v1",
  "rule_set_id": "characterload_inventory",
  "title": "Character load inventory lifecycle propagation",
  "version": 1,
  "status": "active",
  "promotion_compatible": true,

  "stage_order": [
    "character_choose_network_receive",
    "pre_player_loaded_char",
    "player_loaded_char",
    "inventory_initialization",
    "player_loadout",
    "post_player_loadout"
  ],

  "stages": [
    {
      "stage_id": "character_choose_network_receive",
      "expected_kinds": ["net_receive"],
      "match": {
        "any_needles": ["nutCharCreate"]
      }
    },
    {
      "stage_id": "pre_player_loaded_char",
      "expected_kinds": ["hook_emit"],
      "match": {
        "any_needles": ["PrePlayerLoadedChar"]
      }
    },
    {
      "stage_id": "player_loaded_char",
      "expected_kinds": ["hook_emit"],
      "match": {
        "any_needles": ["PlayerLoadedChar"]
      }
    },
    {
      "stage_id": "inventory_initialization",
      "expected_kinds": ["hook_emit", "net_receive"],
      "match": {
        "any_needles": [
          "nutInventoryInit",
          "InventoryInitialized"
        ]
      }
    },
    {
      "stage_id": "player_loadout",
      "expected_kinds": ["hook_emit"],
      "match": {
        "any_needles": ["PlayerLoadout"]
      }
    },
    {
      "stage_id": "post_player_loadout",
      "expected_kinds": ["hook_emit"],
      "match": {
        "any_needles": ["PostPlayerLoadout"]
      }
    }
  ],

  "required_stage_ids": [
    "character_choose_network_receive",
    "player_loaded_char",
    "inventory_initialization",
    "player_loadout",
    "post_player_loadout"
  ],

  "optional_stage_ids": [
    "pre_player_loaded_char"
  ],

  "invalid_conflations": [
    {
      "left": "PrePlayerLoadedChar",
      "right": "PlayerLoadedChar",
      "reason": "They are sibling emissions from the same nutCharChoose flow, not direct propagation."
    }
  ]
}